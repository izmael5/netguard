# Copy this file to .env and fill in real values. Never commit the real .env.

# Flask
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# MySQL
MYSQL_ROOT_PASSWORD=choose_a_strong_root_password
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=netguard
MYSQL_PASSWORD=choose_a_strong_password
MYSQL_DATABASE=netguard

# NVD CVE API — optional, but strongly recommended: request a free key at
# https://nvd.nist.gov/developers/request-an-api-key (raises the rate limit
# from ~5 to ~50 requests/30s so scans with many services finish faster).
NVD_API_KEY=

# Comma-separated allow-list of hosts/IPs/CIDRs you are authorized to scan.
# The app refuses to scan anything not on this list.
ALLOWED_TARGETS=127.0.0.1,localhost,192.168.1.0/24

DEFAULT_PORT_RANGE=1-1024
SCAN_TIMEOUT_SECONDS=300
REPORTS_DIR=/app/reports
